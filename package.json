{
  "name": "nanologin",
  "version": "1.0.0",
  "description": "Programming IDE with browser profiles",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "setup": "mkdir -p .electron-cache && electron_config_cache=\"$(pwd)/.electron-cache\" npm install",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "start": "vite build && electron . --dev",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron . --dev\"",
    "build": "vite build && electron-builder",
    "dist": "vite build && electron-builder --win --x64"
  },
  "keywords": [
    "ide",
    "editor",
    "profile"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "vite": "^6.3.5",
    "vue": "^3.5.16",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^24.20.0",
    "vue-i18n": "^9.14.5"
  },
  "build": {
    "appId": "com.nanologin.app",
    "productName": "NowK IDE",
    "files": [
      "**/*",
      "!dist/**",
      "!renderer/**",
      "!public/**",
      "!public"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
